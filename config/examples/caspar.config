<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <paths>
        <media-path>media/</media-path>
        <log-path disable="false">log/</log-path>
        <data-path>data/</data-path>
        <template-path>template/</template-path>
    </paths>
    <lock-clear-phrase>secret</lock-clear-phrase>
    <ndi>
        <auto-load>true</auto-load>
    </ndi>
    <video-modes>
        <video-mode>
            <id>KAVTOR_MV_2304</id><width>2304</width><height>1080</height>
            <field-count>1</field-count><time-scale>50</time-scale><duration>1</duration>
        </video-mode>
    </video-modes>
    <channels>
        <!-- casparMIX publishes audio peaks without video consumers. Keep
             meter-only channels consumer-free to avoid full-raster rendering
             and GPU-to-CPU readback. Real outputs are configured at runtime. -->
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
        </channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
        </channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
        </channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
        </channel>
