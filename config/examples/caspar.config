        </channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
            <consumers></consumers>
        </channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>1080p5000</video-mode>
        <consumers></consumers></channel>
        <channel><sync-group>kavtor</sync-group>
            <video-mode>KAVTOR_MV_2304</video-mode>
            <consumers>
                <screen />
            </consumers>
        </channel>
        <channel><sync-group>kavtor</sync-group>
